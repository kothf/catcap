#!/usr/bin/python3
"""Run CatCap straight from this folder (no install needed).

    ./run-catcap              open the library (and start the tray icon)
    ./run-catcap --region     capture a region
    ./run-catcap --help       all options

Missing libraries? Run ./install-deps.sh once.
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
os.environ.setdefault("CATCAP_LAUNCHER", os.path.join(HERE, "run-catcap"))

try:
    import gi

    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk  # noqa: F401
    import cairo  # noqa: F401
except (ImportError, ValueError) as exc:
    sys.stderr.write(
        f"CatCap cannot start: {exc}\n"
        "Install the required packages with:\n"
        f"    {os.path.join(HERE, 'install-deps.sh')}\n"
    )
    sys.exit(1)

from catcap.app import main  # noqa: E402

sys.exit(main())
